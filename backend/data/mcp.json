{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_MCP_PAT}"
      }
    },
    "agnes": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "../mcp/agnes",
        "server.py"
      ],
      "env": {
        "AGNES_API_KEY": "${AGNES_TOKEN}",
        "PYTHONUTF8": "1"
      }
    }
  }
}